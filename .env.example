# --- X (Twitter) session used by Twikit to authenticate (public-profile reads only) ---
# X requires a logged-in session for nearly all reads now, even of public profiles.
# X has retired third-party password login, so the supported path is exporting the
# `auth_token` and `ct0` cookies from a browser where you're already logged in to
# x.com (DevTools -> Application/Storage -> Cookies -> x.com). See README
# "Authentication" for step-by-step instructions.
X_AUTH_TOKEN=
X_CT0=

# Legacy fallback only - X has retired password login for most accounts, so this
# will likely fail. Kept in case it's restored for your account type.
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# Path where the Twikit session cookies are cached after first login, so
# subsequent runs don't need to re-authenticate.
X_SESSION_FILE=.data/session.json

# --- Output ---
OUTPUT_DIR=data
JSON_OUTPUT_DIR=data/json
CSV_OUTPUT_DIR=data/csv
LOG_DIR=data/logs

# --- Concurrency & pacing ---
# Max number of profiles fetched concurrently (10 / 20 / 50 / 100).
CONCURRENCY_LIMIT=10
# Minimum delay (seconds) between request bursts, per worker, to stay polite.
REQUEST_DELAY_SECONDS=1.0

# --- Retry / backoff ---
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=30.0
# Rate limits (429s) use this separate, much longer backoff track instead of
# the generic one above - X's read-endpoint rate-limit windows are commonly
# ~15 minutes, and retrying every few seconds just burns through retries
# without the window ever resetting. If X's response reports a reset time,
# that's used directly (capped at RATE_LIMIT_MAX_SECONDS as a sanity bound).
RATE_LIMIT_BASE_SECONDS=30.0
RATE_LIMIT_MAX_SECONDS=900.0

# --- Cache ---
CACHE_ENABLED=true
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM (category agent / dynamic discovery / ranking / analysis) ---
# Groq is the default/primary provider. There is NO curated-account fallback:
# if the selected provider has no API key configured (or a call fails), the
# discovery stage reports a clear error instead of substituting predefined
# accounts. Get a Groq key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional alternative provider - set LLM_PROVIDER=gemini to use this instead.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Category intelligence ---
CATEGORY_CANDIDATE_LIMIT=50
TOP_ACCOUNTS_LIMIT=20
TWEETS_PER_ACCOUNT=10
TWEETS_OUTPUT_DIR=data/tweets
TWEET_CACHE_DIR=.cache/tweets
TWEET_CACHE_TTL_SECONDS=900
# Concurrent tweet-scrape requests. Deliberately independent of (and lower
# than) CONCURRENCY_LIMIT: X's timeline-read endpoint rate-limits noticeably
# more aggressively than the profile-lookup endpoint used for validation.
TWEET_SCRAPE_CONCURRENCY=3

# --- Ask Intelligence (RAG) ---
# Only used by app/rag/* (the `rag` extra - chromadb + sentence-transformers,
# see pyproject.toml). The vector index is derived/regenerable from
# data/tweets/* via scripts/backfill_rag_index.py, so it lives alongside
# .cache/ rather than data/, and is gitignored.
CHROMA_DIR=.chroma
# Minimum similarity (0-1) for a retrieved post to count as evidence at all.
# Needs empirical tuning against your own indexed data.
RAG_MIN_SIMILARITY=0.30
